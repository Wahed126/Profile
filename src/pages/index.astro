---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/hero/Hero.astro';
import ProjectsSection from '@/components/projects/ProjectsSection.astro';
import AboutSection from '@/components/about/AboutSection.astro';
import TipsSection from '@/components/tips/TipsSection.astro';
import TestimonialsSection from '@/components/testimonials/TestimonialsSection.astro';
import ContactCTA from '@/components/contact/ContactCTA.astro';

const seoData = {
  title: "Wahed - Software Engineer & UI/UX Designer",
  description: "Software Engineer focused on frontend development, scalable web applications, and thoughtful user experiences."
};
---

<Layout {...seoData}>
  <div class="flex flex-col gap-4 md:gap-6">
    <Hero />
    <ProjectsSection />
    <AboutSection />
    <TipsSection />
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 md:gap-6 items-stretch pt-0">
      <div class="lg:col-span-5">
        <TestimonialsSection />
      </div>
      <div class="lg:col-span-7">
        <ContactCTA />
      </div>
    </div>
  </div>
</Layout>

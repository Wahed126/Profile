---
import ProfileCard from "./ProfileCard.astro";
import TechStack from "../tech-stack/TechStack.astro";
import HeroBackground from "./HeroBackground";
import HeroText from "./HeroText";
---

<section id="home" class="relative pt-28 pb-0 md:pt-36 md:pb-2">
  {/* Supporting Interactive Living Design System Background */}
  <HeroBackground client:load />

  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
    <!-- Left column: Hero text & Tech Stacks -->
    <div class="lg:col-span-8 flex flex-col pt-4">
      <HeroText client:load />

      <!-- Tech Stack cards under description, next to ProfileCard -->
      <TechStack />
    </div>

    <!-- Right column: Profile Card -->
    <div class="lg:col-span-4 relative flex justify-center lg:justify-end">
      <ProfileCard />
    </div>
  </div>
</section>

<style>
  .wave-ring {
    animation: wave-line 2s cubic-bezier(0, 0.2, 0.8, 1) infinite;
  }

  @keyframes wave-line {
    0% {
      transform: scale(0.8);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
</style>

---
interface Props {
  text?: string;
  class?: string;
}

const { text = "Available for work", class: className = "" } = Astro.props;
---

<div class={`inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs md:text-sm font-medium shadow-sm ${className}`}>
  <span class="relative flex h-3 w-3 items-center justify-center">
    <!-- Outer waving line circle -->
    <span class="wave-ring absolute inline-flex h-full w-full rounded-full border-2 border-emerald-500"></span>
    <!-- Inner filled circle -->
    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.5)]"></span>
  </span>
  <span>{text}</span>
</div>

<style>
  .wave-ring {
    animation: wave-line 2s cubic-bezier(0, 0.2, 0.8, 1) infinite;
  }

  @keyframes wave-line {
    0% {
      transform: scale(0.8);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
</style>


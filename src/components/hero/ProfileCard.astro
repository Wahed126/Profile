---
import { socialLinks } from '@/data/social-links';

const education = [
  { text: "> Uni Passau - M.Sc. CS" },
  { text: "> Herat Uni - B.Sc. CS" },
];

const currentFocus = [
  { text: "> React.js" },
  { text: "> Springboot" },
  { text: "> Vue.js" },
  { text: "> Tailwind.css" },
];
---

<!-- Outer Scroll Reveal Wrapper (Handles entrance & scroll physics) -->
<div
  class="reveal-card reveal-slide-left w-full max-w-[260px]"
  data-scroll-delay="150"
>
  <!-- Inner Interactive Card (Handles levitation, border glow & image zoom) -->
  <div
    class="group bg-card text-card-foreground rounded-[1.75rem] p-2 shadow-card border border-border/80 hover:border-accent/40 w-full flex flex-col transition-all duration-500 cubic-bezier(0.16, 1, 0.3, 1) hover:-translate-y-2 hover:shadow-xl hover:shadow-accent/10"
  >
    <!-- Profile Image container -->
    <div class="relative w-full aspect-[4/5] rounded-[1.25rem] overflow-hidden bg-muted mb-3">
      <img 
        src="/images/profile/wahed.png" 
        alt="Wahed" 
        class="object-cover w-full h-full group-hover:scale-[1.03] transition-transform duration-500 ease-out"
        loading="eager"
      />
    </div>
    
    <div class="px-3.5 pb-4 flex flex-col gap-4">
      <!-- Social Icons -->
      <div class="flex items-center justify-center gap-3 border-b border-border pb-3">
        {socialLinks.map((link) => (
          <a 
            href={link.href} 
            class="text-foreground hover:text-accent transition-colors"
            aria-label={link.name}
            target="_blank"
          >
            <Fragment set:html={link.icon} />
          </a>
        ))}
      </div>
      
      <!-- Education -->
      <div>
        <h3 class="text-[11px] font-bold text-accent mb-2 uppercase tracking-wider">Education</h3>
        <ul class="flex flex-col gap-1.5 text-xs font-medium">
          {education.map(item => (
            <li>{item.text}</li>
          ))}
        </ul>
      </div>
      
      <!-- Current Focus -->
      <div>
        <h3 class="text-[11px] font-bold text-accent mb-2 uppercase tracking-wider">Current Focus</h3>
        <ul class="flex flex-col gap-1.5 text-xs font-medium">
          {currentFocus.map(item => (
            <li>{item.text}</li>
          ))}
        </ul>
      </div>
      
      <!-- Contact Buttons -->
      <div class="flex items-center gap-3 pt-1">
        <a href="mailto:contact@example.com" class="bg-muted p-2.5 rounded-full hover:bg-accent hover:text-accent-foreground transition-colors" aria-label="Email">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
        <a href="https://wa.me/1234567890" target="_blank" class="bg-muted p-2.5 rounded-full hover:bg-accent hover:text-accent-foreground transition-colors" aria-label="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      </div>
    </div>
  </div>
</div>

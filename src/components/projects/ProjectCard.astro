---
import type { Project } from '@/data/projects';
import ProjectMeta from './ProjectMeta.astro';
import ProjectTechStack from './ProjectTechStack.astro';
import ProjectPreview from './ProjectPreview.astro';

export interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
---

<div class="bg-card text-card-foreground border border-border/80 rounded-[1.5rem] p-6 md:p-8 shadow-sm w-full grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8 items-center relative overflow-hidden group">
  
  <div class="lg:col-span-6 flex flex-col justify-center">
    <ProjectMeta 
      index={index} 
      title={data.title} 
      description={data.description} 
    />
    
    <ProjectTechStack 
      technologies={data.technologies} 
    />
  </div>
  
  <div class="lg:col-span-6 flex flex-col justify-center">
    <ProjectPreview 
      id={project.id}
      title={data.title}
      image={data.image}
    />
  </div>
</div>

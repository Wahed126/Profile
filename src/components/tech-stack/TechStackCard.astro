---
export interface Props {
  category: string;
  icon: string;
  items: string[];
  index: number;
}

const { category, icon, items, index = 0 } = Astro.props;
const delay = index * 80;
---

<div
  class="reveal-card reveal-fade-up w-full"
  data-scroll-delay={delay}
>
  <div class="bg-card/90 text-card-foreground border border-border/80 rounded-2xl p-2.5 md:p-3 shadow-card flex flex-col transition-all duration-300 cubic-bezier(0.16, 1, 0.3, 1) hover:-translate-y-1.5 hover:shadow-xl hover:shadow-accent/15 hover:border-accent/50 cursor-pointer">
    <div class="text-accent text-[9px] md:text-[10px] font-bold mb-2.5 flex items-center gap-1.5 tracking-wide">
      <span class="font-mono text-accent font-semibold">{icon}</span>
      <span>{category}</span>
    </div>
    
    <ul class="flex flex-col gap-1 text-[10px] md:text-xs font-medium text-foreground/90 font-mono">
      {items.map(item => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</div>

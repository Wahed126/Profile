---
export interface Props {
  number: string;
  text: string;
  author: string;
}

const { number, text, author } = Astro.props;
---

<div
  class="bg-[#09090b] text-white rounded-[2.2rem] p-6 md:p-8 shadow-sm w-full font-mono relative overflow-hidden border border-neutral-800/80 group"
>
  {/* Texture Layer 1: Ambient Cyan Radial Glow Orb */}
  <div class="absolute -top-16 -right-16 w-60 h-60 bg-accent/15 rounded-full blur-3xl pointer-events-none group-hover:bg-accent/25 transition-all duration-700"></div>

  {/* Texture Layer 2: Micro Dot Matrix */}
  <div class="absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px] opacity-[0.05] pointer-events-none"></div>

  {/* Texture Layer 3: Matte Grain Noise Filter */}
  <div class="absolute inset-0 opacity-30 pointer-events-none mix-blend-overlay bg-repeat" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E&quot;);"></div>

  {/* Content Container */}
  <div class="relative z-10 flex flex-col justify-between">
    <div class="text-white text-base md:text-lg font-bold mb-3 tracking-tight">
      ./Tips {number}
    </div>

    <p class="text-neutral-300 text-xs md:text-sm leading-relaxed mb-4 font-mono">
      {text}
    </p>

    <div class="text-right text-xs md:text-sm text-neutral-400 font-mono">
      {author}
    </div>
  </div>
</div>
